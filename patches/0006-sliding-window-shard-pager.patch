+// PS5 Sliding Window Shard Pager State
+static std::mutex s_shard_mtx;
+static std::atomic<int> s_active_shard{-1};
+static void * s_shared_addr = nullptr;
+static size_t s_max_window_size = 0;
+static std::vector<int> s_shard_fds;
+static std::vector<size_t> s_shard_sizes;
+
+static std::mutex s_tensor_map_mtx;
+static std::unordered_map<const void *, int> s_tensor_to_shard;
+
+extern "C" {
+
+void llama_mmap_register_shard(int idx, int fd, size_t size, void * shared_addr) {
+    std::lock_guard<std::mutex> lock(s_shard_mtx);
+    if (idx >= (int)s_shard_fds.size()) {
+        s_shard_fds.resize(idx + 1, -1);
+        s_shard_sizes.resize(idx + 1, 0);
+    }
+    int d = dup(fd);
+    s_shard_fds[idx] = (d >= 0) ? d : fd;
+    s_shard_sizes[idx] = size;
+    s_shared_addr = shared_addr;
+    if (size > s_max_window_size) {
+        s_max_window_size = size;
+    }
+    if (idx == 0) {
+        s_active_shard.store(0, std::memory_order_relaxed);
+    }
+}
+
+void llama_mmap_activate_shard(int idx) {
+    if (idx < 0) return;
+    if (s_active_shard.load(std::memory_order_relaxed) == idx) {
+        return;
+    }
+
+    std::lock_guard<std::mutex> lock(s_shard_mtx);
+    int current = s_active_shard.load(std::memory_order_relaxed);
+    if (current == idx) {
+        return;
+    }
+
+    if (s_shared_addr != nullptr && idx < (int)s_shard_fds.size() && s_shard_fds[idx] >= 0) {
+        if (current >= 0 && current < (int)s_shard_sizes.size()) {
+            munmap(s_shared_addr, s_shard_sizes[current]);
+        }
+        void * p = mmap(s_shared_addr, s_shard_sizes[idx], PROT_READ, MAP_SHARED | MAP_FIXED, s_shard_fds[idx], 0);
+        if (p == MAP_FAILED) {
+            fprintf(stderr, "[ps5_mmap] activate_shard(%d) FAILED at %p (errno=%d: %s)\n",
+                    idx, s_shared_addr, errno, strerror(errno));
+        } else {
+            s_active_shard.store(idx, std::memory_order_release);
+        }
+    }
+}
+
+void llama_mmap_record_tensor_shard(const struct ggml_tensor * t, int shard_idx) {
+    if (!t) return;
+    std::lock_guard<std::mutex> lock(s_tensor_map_mtx);
+    s_tensor_to_shard[(const void *)t] = shard_idx;
+}
+
+int llama_mmap_get_tensor_shard(const struct ggml_tensor * t) {
+    if (!t) return -1;
+    const struct ggml_tensor * cur = t;
+    while (cur->view_src) {
+        cur = cur->view_src;
+    }
+    std::lock_guard<std::mutex> lock(s_tensor_map_mtx);
+    auto it = s_tensor_to_shard.find((const void *)cur);
+    if (it != s_tensor_to_shard.end()) {
+        return it->second;
+    }
+    it = s_tensor_to_shard.find((const void *)t);
+    if (it != s_tensor_to_shard.end()) {
+        return it->second;
+    }
+    return -1;
+}
+
+void llama_mmap_check_tensor(const struct ggml_tensor * t) {
+    if (!t || !s_shared_addr) return;
+
+    // Fast check: if tensor data does not fall within shared mmap window, it's RAM activation
+    uintptr_t p = (uintptr_t)t->data;
+    uintptr_t base = (uintptr_t)s_shared_addr;
+    if (p < base || p >= base + s_max_window_size) {
+        return;
+    }
+
+    int shard = llama_mmap_get_tensor_shard(t);
+    if (shard >= 0) {
+        llama_mmap_activate_shard(shard);
+    }
+}
+
+} // extern "C"
